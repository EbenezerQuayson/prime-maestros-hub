// Prime Maestros Hub (PMH) - PostgreSQL / Prisma Schema
// Baseline aligned with SRS v1.0 (Section 8, Section 10, Section 17)
// Monetary values use integer minor units (pesewas, 1 GHS = 100 pesewas).
// Timestamps are stored in UTC (timestamptz) and displayed in Africa/Accra.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum UserStatus {
  INVITED
  ACTIVE
  LOCKED
  DISABLED
}

enum AuthTokenType {
  ACTIVATION
  PASSWORD_RESET
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum ApplicationStatus {
  DRAFT
  PAYMENT_PENDING
  AWAITING_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum EnrollmentStatus {
  PENDING_APPROVAL
  ACTIVE
  COMPLETED
  REJECTED
  SUSPENDED
  WITHDRAWN
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ResourceType {
  PDF
  VIDEO
  AUDIO
  IMAGE
  SHEET_MUSIC
  LINK
}

enum ResourceVisibility {
  ENROLLED_ONLY
  INSTRUCTORS_ONLY
  PUBLIC_PREVIEW
}

enum ClassSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum BillingFrequency {
  MONTHLY
  TERMLY
  ONE_TIME
}

enum InvoiceType {
  REGISTRATION
  MONTHLY_TUITION
  OTHER
}

enum InvoiceStatus {
  DRAFT
  PENDING
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  FAILED
  CANCELLED
  EXPIRED
  VOID
}

enum PaymentProvider {
  PAYSTACK
  HUBTEL
}

enum PaymentStatus {
  INITIALIZED
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  REVERSED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  REVIEWED
  RESUBMIT_REQUESTED
}

enum AssessmentType {
  THEORY
  PRACTICAL
  COMBINED
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ============================================================================
// Identity, Authentication & Access Control
// ============================================================================

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  phone           String?
  passwordHash    String?    @map("password_hash")
  role            Role       @default(STUDENT)
  status          UserStatus @default(INVITED)
  mfaEnabled      Boolean    @default(false) @map("mfa_enabled")
  mfaSecret       String?    @map("mfa_secret")
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  student               Student?
  instructor            Instructor?
  refreshTokens         RefreshToken[]
  authTokens            AuthToken[]
  reviewedApplications  Application[]      @relation("ApplicationReviewer")
  markedAttendances     Attendance[]       @relation("AttendanceMarker")
  uploadedResources     LearningResource[] @relation("ResourceUploader")
  reviewedSubmissions   Submission[]       @relation("SubmissionReviewer")
  notifications         Notification[]
  auditLogs             AuditLog[]         @relation("AuditActor")
  updatedSettings       AcademySetting[]   @relation("SettingUpdater")

  @@index([role, status])
  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

// ============================================================================
// Profiles: Students & Instructors
// ============================================================================

model Student {
  id                           String    @id @default(uuid()) @db.Uuid
  userId                       String    @unique @map("user_id") @db.Uuid
  studentNumber                String    @unique @map("student_number")
  firstName                    String    @map("first_name")
  lastName                     String    @map("last_name")
  dateOfBirth                  DateTime? @map("date_of_birth") @db.Date
  phone                        String
  email                        String
  address                      String?
  emergencyContactName         String?   @map("emergency_contact_name")
  emergencyContactPhone        String?   @map("emergency_contact_phone")
  emergencyContactRelationship String?   @map("emergency_contact_relationship")
  guardianName                 String?   @map("guardian_name")
  guardianPhone                String?   @map("guardian_phone")
  guardianEmail                String?   @map("guardian_email")
  guardianConsentAt            DateTime? @map("guardian_consent_at") @db.Timestamptz(6)
  createdAt                    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  applications   Application[]
  enrollments    Enrollment[]
  attendances    Attendance[]
  invoices       Invoice[]
  submissions    Submission[]
  lessonProgress LessonProgress[]

  @@index([lastName, firstName])
  @@map("students")
}

model StudentNumberCounter {
  year         Int      @id
  lastSequence Int      @default(0) @map("last_sequence")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("student_number_counters")
}

model Instructor {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @unique @map("user_id") @db.Uuid
  firstName        String           @map("first_name")
  lastName         String           @map("last_name")
  phone            String?
  bio              String?
  qualifications   String?
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  instruments InstructorInstrument[]
  classes     Class[]
  enrollments Enrollment[]
  assignments Assignment[]
  assessments Assessment[]

  @@index([active, employmentStatus])
  @@map("instructors")
}

model InstructorInstrument {
  instructorId String   @map("instructor_id") @db.Uuid
  instrumentId String   @map("instrument_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@id([instructorId, instrumentId])
  @@map("instructor_instruments")
}

// ============================================================================
// Academic Catalog: Instruments, Programs, Courses, Modules, Lessons, Resources
// ============================================================================

model Instrument {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  programs     Program[]
  applications Application[]
  instructors  InstructorInstrument[]
  classes      Class[]
  feePlans     FeePlan[]

  @@map("instruments")
}

model Program {
  id            String   @id @default(uuid()) @db.Uuid
  instrumentId  String   @map("instrument_id") @db.Uuid
  name          String
  slug          String   @unique
  description   String?
  durationWeeks Int?     @map("duration_weeks")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  instrument  Instrument   @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  courses     Course[]
  enrollments Enrollment[]
  feePlans    FeePlan[]

  @@index([instrumentId, active])
  @@map("programs")
}

model Course {
  id          String      @id @default(uuid()) @db.Uuid
  programId   String      @map("program_id") @db.Uuid
  level       CourseLevel @default(BEGINNER)
  title       String
  description String?
  sequence    Int
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  program     Program      @relation(fields: [programId], references: [id], onDelete: Restrict)
  modules     Module[]
  enrollments Enrollment[]
  assignments Assignment[]

  @@unique([programId, sequence])
  @@index([programId, active])
  @@map("courses")
}

model Module {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  title       String
  description String?
  sequence    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, sequence])
  @@map("modules")
}

model Lesson {
  id              String   @id @default(uuid()) @db.Uuid
  moduleId        String   @map("module_id") @db.Uuid
  title           String
  objectives      String?
  content         String?
  sequence        Int
  durationMinutes Int?     @map("duration_minutes")
  published       Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  module    Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources LearningResource[]
  progress  LessonProgress[]

  @@unique([moduleId, sequence])
  @@map("lessons")
}

model LearningResource {
  id            String             @id @default(uuid()) @db.Uuid
  lessonId      String             @map("lesson_id") @db.Uuid
  title         String
  type          ResourceType
  storageKey    String?            @map("storage_key")
  externalUrl   String?            @map("external_url")
  mimeType      String?            @map("mime_type")
  fileSizeBytes Int?               @map("file_size_bytes")
  visibility    ResourceVisibility @default(ENROLLED_ONLY)
  uploadedById  String             @map("uploaded_by_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  lesson     Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("ResourceUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([lessonId])
  @@map("learning_resources")
}

// ============================================================================
// Onboarding, Applications & Enrollments
// ============================================================================

model Application {
  id                    String            @id @default(uuid()) @db.Uuid
  applicationTokenHash  String            @unique @map("application_token_hash")
  studentId             String?           @map("student_id") @db.Uuid
  instrumentId          String            @map("instrument_id") @db.Uuid
  firstName             String            @map("first_name")
  lastName              String            @map("last_name")
  email                 String
  phone                 String
  dateOfBirth           DateTime?         @map("date_of_birth") @db.Date
  address               String?
  emergencyContactName  String?           @map("emergency_contact_name")
  emergencyContactPhone String?           @map("emergency_contact_phone")
  experienceLevel       String?           @map("experience_level")
  goals                 String?
  availability          String?
  consentAcceptedAt     DateTime          @map("consent_accepted_at") @db.Timestamptz(6)
  status                ApplicationStatus @default(PAYMENT_PENDING)
  reviewerId            String?           @map("reviewer_id") @db.Uuid
  reviewedAt            DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  decisionReason        String?           @map("decision_reason")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  student    Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  instrument Instrument  @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  reviewer   User?       @relation("ApplicationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  enrollment Enrollment?
  invoices   Invoice[]

  @@index([email, status])
  @@index([status, createdAt])
  @@map("applications")
}

model Enrollment {
  id            String           @id @default(uuid()) @db.Uuid
  studentId     String           @map("student_id") @db.Uuid
  applicationId String?          @unique @map("application_id") @db.Uuid
  programId     String           @map("program_id") @db.Uuid
  courseId      String           @map("course_id") @db.Uuid
  instructorId  String?          @map("instructor_id") @db.Uuid
  classId       String?          @map("class_id") @db.Uuid
  feePlanId     String?          @map("fee_plan_id") @db.Uuid
  status        EnrollmentStatus @default(PENDING_APPROVAL)
  enrolledAt    DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  startedAt     DateTime?        @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime?        @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  student     Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  program     Program      @relation(fields: [programId], references: [id], onDelete: Restrict)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  instructor  Instructor?  @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  class       Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  feePlan     FeePlan?     @relation(fields: [feePlanId], references: [id], onDelete: SetNull)
  invoices    Invoice[]
  assessments Assessment[]

  @@index([studentId, status])
  @@index([classId, status])
  @@index([instructorId, status])
  @@map("enrollments")
}

// ============================================================================
// Physical Classes, Sessions & Attendance
// ============================================================================

model Class {
  id           String      @id @default(uuid()) @db.Uuid
  name         String
  instrumentId String      @map("instrument_id") @db.Uuid
  level        CourseLevel @default(BEGINNER)
  instructorId String      @map("instructor_id") @db.Uuid
  venue        String
  room         String?
  capacity     Int
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  instrument  Instrument     @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  instructor  Instructor     @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  sessions    ClassSession[]
  enrollments Enrollment[]

  @@index([instrumentId, active])
  @@index([instructorId, active])
  @@map("classes")
}

model ClassSession {
  id        String             @id @default(uuid()) @db.Uuid
  classId   String             @map("class_id") @db.Uuid
  startsAt  DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime           @map("ends_at") @db.Timestamptz(6)
  venue     String
  room      String?
  status    ClassSessionStatus @default(SCHEDULED)
  notes     String?
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@index([classId, startsAt])
  @@map("class_sessions")
}

model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  classSessionId String           @map("class_session_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  status         AttendanceStatus
  markedById     String           @map("marked_by_id") @db.Uuid
  notes          String?
  markedAt       DateTime         @default(now()) @map("marked_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  markedBy     User         @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: Restrict)

  @@unique([classSessionId, studentId])
  @@index([studentId])
  @@map("attendances")
}

// ============================================================================
// Billing, Invoices & Payments (Minor Currency Units: Pesewas)
// ============================================================================

model FeePlan {
  id               String           @id @default(uuid()) @db.Uuid
  name             String
  instrumentId     String?          @map("instrument_id") @db.Uuid
  programId        String?          @map("program_id") @db.Uuid
  level            CourseLevel?
  amountPesewas    Int              @map("amount_pesewas")
  currency         String           @default("GHS")
  billingFrequency BillingFrequency @default(MONTHLY) @map("billing_frequency")
  gracePeriodDays  Int              @default(7) @map("grace_period_days")
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  instrument  Instrument?  @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  program     Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]
  invoices    Invoice[]

  @@index([active])
  @@map("fee_plans")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  studentId     String?       @map("student_id") @db.Uuid
  applicationId String?       @map("application_id") @db.Uuid
  enrollmentId  String?       @map("enrollment_id") @db.Uuid
  type          InvoiceType
  feePlanId     String?       @map("fee_plan_id") @db.Uuid
  invoiceNumber String        @unique @map("invoice_number")
  amountPesewas Int           @map("amount_pesewas")
  currency      String        @default("GHS")
  billingPeriod String?       @map("billing_period")
  dueDate       DateTime      @map("due_date") @db.Timestamptz(6)
  status        InvoiceStatus @default(PENDING)
  issuedAt      DateTime      @default(now()) @map("issued_at") @db.Timestamptz(6)
  paidAt        DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  student     Student?     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  enrollment  Enrollment?  @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  feePlan     FeePlan?     @relation(fields: [feePlanId], references: [id], onDelete: SetNull)
  payments    Payment[]

  @@index([studentId, status])
  @@index([applicationId])
  @@index([status, dueDate])
  @@map("invoices")
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  invoiceId         String          @map("invoice_id") @db.Uuid
  provider          PaymentProvider
  providerReference String          @unique @map("provider_reference")
  providerEventId   String?         @unique @map("provider_event_id")
  amountPesewas     Int             @map("amount_pesewas")
  currency          String          @default("GHS")
  channel           String?
  status            PaymentStatus   @default(INITIALIZED)
  rawPayload        Json?           @map("raw_payload")
  paidAt            DateTime?       @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId, status])
  @@map("payments")
}

// ============================================================================
// Coursework: Assignments, Submissions, Assessments & Progress
// ============================================================================

model Assignment {
  id           String           @id @default(uuid()) @db.Uuid
  courseId     String           @map("course_id") @db.Uuid
  instructorId String           @map("instructor_id") @db.Uuid
  title        String
  instructions String
  dueAt        DateTime?        @map("due_at") @db.Timestamptz(6)
  status       AssignmentStatus @default(DRAFT)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor  Instructor   @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  submissions Submission[]

  @@index([courseId, status])
  @@map("assignments")
}

model Submission {
  id           String           @id @default(uuid()) @db.Uuid
  assignmentId String           @map("assignment_id") @db.Uuid
  studentId    String           @map("student_id") @db.Uuid
  text         String?
  fileKey      String?          @map("file_key")
  externalUrl  String?          @map("external_url")
  submittedAt  DateTime         @default(now()) @map("submitted_at") @db.Timestamptz(6)
  status       SubmissionStatus @default(SUBMITTED)
  feedback     String?
  reviewedById String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  reviewedBy User?      @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@map("submissions")
}

model Assessment {
  id           String         @id @default(uuid()) @db.Uuid
  enrollmentId String         @map("enrollment_id") @db.Uuid
  instructorId String         @map("instructor_id") @db.Uuid
  type         AssessmentType
  title        String
  score        Decimal        @db.Decimal(5, 2)
  maxScore     Decimal        @map("max_score") @db.Decimal(5, 2)
  feedback     String?
  assessedAt   DateTime       @default(now()) @map("assessed_at") @db.Timestamptz(6)
  releasedAt   DateTime?      @map("released_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Restrict)

  @@index([enrollmentId])
  @@map("assessments")
}

model LessonProgress {
  id          String               @id @default(uuid()) @db.Uuid
  studentId   String               @map("student_id") @db.Uuid
  lessonId    String               @map("lesson_id") @db.Uuid
  status      LessonProgressStatus @default(NOT_STARTED)
  completedAt DateTime?            @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@map("lesson_progress")
}

// ============================================================================
// Notifications, Audit Trail & Academy Settings
// ============================================================================

model Notification {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  channel      NotificationChannel @default(EMAIL)
  type         String
  subject      String?
  content      String
  status       NotificationStatus  @default(PENDING)
  sentAt       DateTime?           @map("sent_at") @db.Timestamptz(6)
  errorMessage String?             @map("error_message")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model AcademySetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy User? @relation("SettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("academy_settings")
}
