# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://pmh_user:pmh_dev_password@localhost:5432/prime_maestros_hub?schema=public"

# Authentication (change these in production!)
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_DAYS=7

# Academy Baseline Rules
REGISTRATION_FEE_PESEWAS=5000
DEFAULT_CURRENCY=GHS
ACADEMY_TIMEZONE=Africa/Accra

# Payment Provider (Paystack or Hubtel - configure after merchant onboarding)
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Transactional Email (Resend or local Mailpit SMTP)
EMAIL_FROM="Prime Maestros Hub <noreply@primemaestros.local>"
SMTP_HOST=localhost
SMTP_PORT=1025

# Development Seed Account (only used by prisma:seed in dev)
SEED_SUPER_ADMIN_EMAIL=superadmin@primemaestros.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
